# Build context is the repository root for both images.
.git
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
.coverage
frontend/build
backend/uploads/**/*
!backend/uploads/**/.gitkeep
backend/evaluation
backend/tests
experiments
reference
docs
outputs
# backend/.env stays in the context: scripts/deploy.sh sets only DEBUG,
# LOG_LEVEL and CORS_ORIGINS on Cloud Run, so the image carries the rest.

# Local secrets never enter the build context; compose passes .env at runtime.
.env
