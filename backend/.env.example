# Backend environment for local development.
# Copy to backend/.env; backend/config/settings.py loads it on startup.
# Every variable is optional. Meter analysis works with none of them set.

# Flask
SECRET_KEY=change-me
DEBUG=false
PORT=5000
LOG_LEVEL=INFO
# text, or json for one JSON object per line
LOG_FORMAT=text
# Comma-separated list, or * to allow any origin
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_CONTENT_LENGTH=16777216
# Rate limiter storage, memory:// by default
REDIS_URL=memory://
RATELIMIT_DEFAULT=100 per hour

# Supabase: auth, community feed and contributions (https://<project-ref>.supabase.co)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Direct Postgres access, used only by backend/scripts/*
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
DB_PASSWORD=

# Auth
AUTH_EMAIL_DOMAIN=merucoders.app
FRONTEND_URL=http://localhost:8080
# Admin login is disabled until ADMIN_PASSWORD is set
ADMIN_USERNAME=admin-erase-sure
ADMIN_PASSWORD=

# Gemini keys for the chatbot and AI input validation, tried in order
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# Google Cloud service account JSON for Cloud Vision OCR and Cloud TTS
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-credentials.json

# Hugging Face token for the Sanskrit TTS model in API mode
HF_TOKEN=

# IndicConformer speech-to-text endpoint; voice input is disabled when empty
INDIC_ASR_URL=

# Syllabizer: auto, icu or sanskrit_text
SYLLABIZATION_METHOD=auto

# Upload cleanup job
CLEANUP_INTERVAL_MINUTES=60
FILE_MAX_AGE_MINUTES=60
